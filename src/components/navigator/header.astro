---
import { getWorks } from "../../utils/dataService";
const pages = await getWorks();
const currentPath = Astro.url.pathname.replace(/\/$/, "") || "/";
---

<header
  class="fixed top-0 left-0 w-full z-50 flex justify-between items-center px-6 py-4 md:px-8 md:py-5 text-white mix-blend-difference"
>
  <a
    href="/"
    class="group flex items-center gap-1.5 font-sm font-bold opacity-50 hover:opacity-100 transition-opacity"
  >
    <i class="i-ph-arrow-left transition-transform group-hover:-translate-x-1"
    ></i>
    Projects
  </a>

  <nav class="flex gap-6 items-center lg:gap-8 text-xs font-bold">
    {
      pages.map((p) => {
        const isActive = currentPath === `/${p.slug}`;
        return (
          <a
            href={`/${p.slug}`}
            class:list={[
              "hover:opacity-100 transition-opacity",
              {
                "opacity-50": !isActive,
              },
            ]}
          >
            {p.workName}
          </a>
        );
      })
    }
  </nav>
</header>
